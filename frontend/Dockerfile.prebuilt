# Same runtime image as Dockerfile, but packages a dist/ built on the host with the Firebase settings from .env
# (the Dockerfile's build stage cannot see .env). Build: VITE_API_BASE_URL=<backend url> npm run build
FROM nginx:1.27-alpine
COPY dist /usr/share/nginx/html
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
ENV PORT=8080
EXPOSE 8080
